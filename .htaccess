# biotela.ru — статическая копия сайта (Apache)
DirectoryIndex index.html
Options -Indexes -MultiViews
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

RewriteEngine On

# https и www — ВКЛЮЧИТЬ после запуска на боевом домене (убрать # в 3 строках ниже)
#RewriteCond %{HTTPS} !=on [OR]
#RewriteCond %{HTTP_HOST} !^www\. [NC]
#RewriteRule ^ https://www.biotela.ru%{REQUEST_URI} [R=301,L,NE]

# старые ссылки-посредники -> страницы товаров
RewriteRule ^products-links/(artrovit|carnitin|d-glukarat-kaltsiya|inulin|kollagen|magnehelat|q-10|taurin|triptofan1|vitamin-d3)/?$ /$1 [R=301,L]

# /page.html -> /page ; /page/ -> /page
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# /page -> page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/png "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType text/css "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType text/html "access plus 10 minutes"
</IfModule>
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml
</IfModule>
